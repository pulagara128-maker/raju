# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Public Google Maps JavaScript & Places API key.
VITE_GOOGLE_MAPS_API_KEY=

# ADMIN_EMAILS: Comma-separated Google account emails authorized as restaurant admins.
ADMIN_EMAILS=

# STAFF_EMAILS: Optional comma-separated Google account emails authorized as kitchen/counter staff.
STAFF_EMAILS=

# WHATSAPP_ACCESS_TOKEN: Optional WhatsApp Business Cloud API bearer token for automated festival greetings.
WHATSAPP_ACCESS_TOKEN=

# WHATSAPP_PHONE_NUMBER_ID: Optional WhatsApp Business Cloud API phone number ID.
WHATSAPP_PHONE_NUMBER_ID=
